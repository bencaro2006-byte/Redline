{
  "name": "redline-optimizer",
  "productName": "Redline Optimizer",
  "version": "0.1.0",
  "description": "Reversible, documented Windows tweaks for gaming PCs: system scan, 61 optimizations with backups, debloat and per-game settings.",
  "author": "Redline",
  "license": "MIT",
  "homepage": "https://github.com/bencaro2006-byte/Redline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bencaro2006-byte/Redline.git"
  },
  "bugs": {
    "url": "https://github.com/bencaro2006-byte/Redline/issues"
  },
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "build": "node scripts/hash-scripts.mjs && npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "icons": "node scripts/make-icons.mjs",
    "hash-scripts": "node scripts/hash-scripts.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "ps-smoke": "node scripts/ps-smoke.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/saira": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.54.0",
    "png-to-ico": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
